local frames = 0
local lastTime = tick()

RunService.RenderStepped:Connect(function()
	frames = frames + 1
	local now = tick()
	if now - lastTime >= 1 then
		-- Update FPS
		local fps = math.floor(frames / (now - lastTime))
		lblFps.Text = tostring(fps) .. " FPS"
		frames = 0
		lastTime = now
		
		-- Update Time
		lblTime.Text = os.date("%I:%M %p") .. " | " .. countryCode
		
		-- Update Ping and Color Code
		local ping = 0
		pcall(function()
			ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
		end)
		lblPing.Text = tostring(ping) .. "ms"
		
		if ping < 50 then
			lblPing.TextColor3 = THEME.Success
		elseif ping <= 100 then
			lblPing.TextColor3 = THEME.Warn
		else
			lblPing.TextColor3 = THEME.Danger
		end
	end
end)

