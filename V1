local function saveCfg()
    if type(writefile) ~= "function" then return end
    pcall(writefile, "antilose_cfg.txt", SIZES[sizeIdx] .. "," .. FORMATS[fmtIdx])
end

local function loadCfg()
    if type(readfile) ~= "function" then return end
    local ok, s = pcall(readfile, "antilose_cfg.txt")
    if not ok or type(s) ~= "string" then return end
    local a, b = s:match("(%d+),(%a+)")
    if a then
        for i, v in ipairs(SIZES) do if v == tonumber(a) then sizeIdx = i end end
    end
    if b then
        for i, v in ipairs(FORMATS) do if v == b then fmtIdx = i end end
    end
end

