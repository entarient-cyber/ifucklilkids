-- MINIMIZE/RESTORE
local function minimizeWindow()
	if isMinimized or not isVisible then return end
	isMinimized = true
	playClick(1.2)
	
	local targetPos = UDim2.new(0.5, 0, 0, 34)
	local outTween = tween(window, { Size = UDim2.new(0,0,0,0), Position = targetPos, BackgroundTransparency = 1 }, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tween(shadow, { Size = UDim2.new(0,0,0,0), Position = targetPos, BackgroundTransparency = 1 }, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	
	outTween.Completed:Connect(function()
		if isMinimized then
			window.Visible = false
			shadow.Visible = false
			miniWidget.Visible = true
			miniWidget.Size = UDim2.new(0, 0, 0, 46)
			tween(miniWidget, {Size = UDim2.new(0, 200, 0, 46)}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end
	end)
end

local function restoreWindow()
	if not isMinimized then return end
	isMinimized = false
	playClick(0.8)
	
	local outTween = tween(miniWidget, { Size = UDim2.new(0,0,0,46) }, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	outTween.Completed:Connect(function()
		if not isMinimized then
			miniWidget.Visible = false
			window.Visible = true
			shadow.Visible = true
			
			window.Size = UDim2.new(0, 604, 0, 418)
			window.Position = UDim2.new(0.5, 0, 0.5, 0)
			window.BackgroundTransparency = 1
			
			shadow.Size = UDim2.new(0, 604, 0, 418)
			shadow.Position = UDim2.new(0.5, 0, 0.5, 6)
			shadow.BackgroundTransparency = 1
			
			tween(window, { Size = UDim2.new(0, 654, 0, 468), BackgroundTransparency = TRANSPARENCY }, 0.35, Enum.EasingStyle.Back)
			tween(shadow, { Size = UDim2.new(0, 654, 0, 468), BackgroundTransparency = 0.7 }, 0.35, Enum.EasingStyle.Back)
		end
	end)
end

