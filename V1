_G.__showPage = function(id)
	currentPageId = id
	for i, tab in ipairs(TABS) do
		local tid = tab.id
		local active = (tid == id)
		
		navButtons[tid].BackgroundTransparency = 1
		
		local lbl = navLabels[tid]
		if lbl then tween(lbl, { TextColor3 = active and THEME.MagmaGlow or THEME.TextDim }, 0.2) end

		local iconColor = active and THEME.MagmaGlow or THEME.TextDim
		local parts = navParts[tid]
		if parts then
			for _, pt in ipairs(parts) do
				if pt:IsA("UIStroke") then
					tween(pt, { Color = iconColor }, 0.2)
				elseif pt:IsA("ImageLabel") then
					tween(pt, { ImageColor3 = iconColor }, 0.2)
				else
					tween(pt, { BackgroundColor3 = iconColor }, 0.2)
				end
			end
		end

		local ibg = navIconBgs[tid]
		if ibg then
			local bgColor = active and THEME.MagmaMid:Lerp(THEME.SurfaceHi, 0.8) or THEME.SurfaceHi
			tween(ibg, { BackgroundColor3 = bgColor }, 0.2)
		end
	end
	for pid, p in pairs(pages) do
		p.Visible = (pid == id)
	end
end

