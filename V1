local function applyScale()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	if vp.X == 0 or vp.Y == 0 then return end
	local s = math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.75, 1.05) 
	
	if UserInputService.TouchEnabled then
		s = math.max(s, 0.8)
	end
	
	uiScale.Scale = s
end
applyScale()

local cameraConn
local function bindCamera()
	local cam = workspace.CurrentCamera
	if not cam then return end
	if cameraConn then cameraConn:Disconnect() end
	cameraConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
	table.insert(connections, cameraConn)
end
bindCamera()
connect(workspace:GetPropertyChangedSignal("CurrentCamera"), function()
	bindCamera(); applyScale()
end)

function setVisible(state)
	if isMinimized then
		if not state then
			miniWidget.Visible = false
		else
			restoreWindow()
		end
		return
	end

	if isVisible == state then return end
	isVisible = state
	if state then
		window.Visible = true; shadow.Visible = true
		
		window.Size = UDim2.new(0, 604, 0, 418); window.BackgroundTransparency = 1
		shadow.Size = UDim2.new(0, 604, 0, 418); shadow.BackgroundTransparency = 1
		
		tween(window, { Size=UDim2.new(0, 654, 0, 468), BackgroundTransparency=TRANSPARENCY }, 0.42, Enum.EasingStyle.Back)
		tween(shadow, { Size=UDim2.new(0, 654, 0, 468), BackgroundTransparency=0.7 }, 0.42, Enum.EasingStyle.Back)
	else
		tween(window, { Size=UDim2.new(0, 604, 0, 418), BackgroundTransparency=1 }, 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		
		local t = tween(shadow, { Size=UDim2.new(0, 604, 0, 418), BackgroundTransparency=1 }, 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if not isVisible and not isMinimized then window.Visible=false; shadow.Visible=false end
		end)
	end
end

do
	local dragging    = false
	local dragStart   = nil
	local startPos    = nil
	local activeTouch = nil
	local endConn     = nil

	local function stopDrag()
		dragging    = false
		dragStart   = nil
		startPos    = nil
		activeTouch = nil
		if endConn then
			endConn:Disconnect()
			endConn = nil
		end
	end

	topbar.Active = true

	topbar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging    = true
			dragStart   = input.Position
			startPos    = window.Position
			activeTouch = nil

			if endConn then endConn:Disconnect() end
			endConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End
					or input.UserInputState == Enum.UserInputState.Cancel then
					stopDrag()
				end
			end)

		elseif input.UserInputType == Enum.UserInputType.Touch then
			dragging    = true
			dragStart   = input.Position
			startPos    = window.Position
			activeTouch = input

			if endConn then endConn:Disconnect() end
			endConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End
					or input.UserInputState == Enum.UserInputState.Cancel then
					stopDrag()
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging or not dragStart then return end

		if input.UserInputType == Enum.UserInputType.MouseMovement then
			if activeTouch ~= nil then return end
		elseif input.UserInputType == Enum.UserInputType.Touch then
			if input ~= activeTouch then return end
		else
			return
		end

		local delta = input.Position - dragStart
		local scale = (uiScale and uiScale.Scale > 0) and uiScale.Scale or 1

		local newPos = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X / scale,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y / scale
		)

		window.Position = newPos
		shadow.Position = newPos
	end)

	UserInputService.InputEnded:Connect(function(input)
		if activeTouch ~= nil and input == activeTouch then
			stopDrag()
		elseif activeTouch == nil and dragging
			and input.UserInputType == Enum.UserInputType.MouseButton1 then
			stopDrag()
		end
	end)
	UserInputService.WindowFocusReleased:Connect(stopDrag)
end

local TOGGLE_KEY = Enum.KeyCode.K

connect(UserInputService.InputBegan, function(input, gpe)
	if gpe then return end
	if _G.__isAwaiting and _G.__isAwaiting() then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			TOGGLE_KEY = input.KeyCode
			if _G.__setKey then _G.__setKey(input.KeyCode) end
			notify("Keybind", "Bound to " .. input.KeyCode.Name, THEME.MagmaMid)
		end
		return
	end
	if input.KeyCode == TOGGLE_KEY then
		setVisible(not isVisible)
	end
end)

