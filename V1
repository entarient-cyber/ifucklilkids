local focusConns = {}
local noTimeFreezeOn = false
local function setNoTimeFreeze(on)
	for _, c in ipairs(focusConns) do
		pcall(function() c:Disconnect() end)
	end
	focusConns = {}
	noTimeFreezeOn = on
	if not on then
		return
	end
	local okSys, sys = pcall(function()
		return ReplicatedStorage:WaitForChild("System", 5)
	end)
	if not okSys or sys == nil then
		print("no system remote")
		return
	end
	local function spoof()
		for i = 1, 2 do
			pcall(function() sys:FireServer("Focused") end)
			task.wait(0.1)
		end
	end
	table.insert(focusConns, UserInputService.WindowFocusReleased:Connect(spoof))
	table.insert(focusConns, UserInputService.WindowFocused:Connect(spoof))
	task.spawn(spoof)
end

local antiAfkOn = false
local function runAntiAfk()
	local loadFn = loadstring or load
	if type(loadFn) ~= "function" then
		print("afk failed, no loader")
		return
	end
	local okFetch, src = pcall(function()
		return game:HttpGet("https://rawscripts.net/raw/Universal-Script-Anti-AFK-82804")
	end)
	if not okFetch or type(src) ~= "string" or src == "" then
		print("afk fetch failed")
		return
	end
	local okCompile, chunk = pcall(function()
		return loadFn(src)
	end)
	if not okCompile or type(chunk) ~= "function" then
		print("afk compile failed")
		return
	end
	task.spawn(function()
		local okRun, errRun = pcall(chunk)
		if okRun then
			antiAfkOn = true
		else
			print("afk error:", tostring(errRun))
		end
	end)
end

