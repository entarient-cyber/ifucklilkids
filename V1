    borderGrad.Rotation = (borderGrad.Rotation + (active and 160 or 60) * dt) % 360

    acc += dt
    if acc < 0.3 then return end
    acc = 0

    if not api then
        status.Text = "core failed - check console"
        status.TextColor3 = COLORS.accentBright
        return
    end

    if not active then
        status.Text = "idle  |  " .. sizeBtn.Text .. "  |  " .. fmtBtn.Text
        status.TextColor3 = COLORS.dim
        lastPasses, lastT = 0, os.clock()
    else
        local ms, passes, mem, children, queued, reason, payloadMb, interval = api.stats()
        local now = os.clock()
        local rate = (passes - lastPasses) / math.max(now - lastT, 1e-3)
        lastPasses, lastT = passes, now

        status.Text = string.format("%.1fs | %.1f MB | q %.0f MB | %.2f/s",
            interval or 0, payloadMb or 0, queued or 0, rate)

        if (queued or 0) > 200 then
            status.TextColor3 = COLORS.accentBright
        elseif reason ~= "" and reason ~= "at floor" then
            status.TextColor3 = COLORS.accent
        else
            status.TextColor3 = COLORS.dim
        end
    end

    pacc += 0.3
    if panel.Visible and pacc >= 0.6 then
        pacc = 0
        refreshPlayers()
    end
end)

loadCfg()
sizeBtn.Text = SIZELBL[SIZES[sizeIdx]]
fmtBtn.Text = FMTLBL[FORMATS[fmtIdx]]
if CONFIG.panelOpen then
    panel.Visible = true
    listBtn.Text = "HIDE"
end

refreshPlayers()
if CONFIG.autoStart then setActive(true) end
