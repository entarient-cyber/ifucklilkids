local function refreshPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        list[#list + 1] = p
    end
    table.sort(list, function(a, b)
        if a == player then return true end
        if b == player then return false end
        return a.Name:lower() < b.Name:lower()
    end)

    local children = api and api.children and api.children() or 0
    local seen, hit = {}, 0

    for i, p in ipairs(list) do
        seen[p] = true
        local r = rows[p]
        if not r then
            r = createRow()
            rows[p] = r
        end
        r.row.LayoutOrder = i

        local isSelf = (p == player)
        local inRange = isSelf or (p.UserId <= children)
        if inRange and not isSelf then hit += 1 end

        r.name.Text = (p.DisplayName ~= p.Name and p.DisplayName or p.Name) .. (isSelf and "  (you)" or "")
        r.uid.Text = "#" .. tostring(p.UserId)
        r.dot.BackgroundColor3 = isSelf and COLORS.accentBright
            or (inRange and COLORS.good or COLORS.dim)
        r.name.TextColor3 = inRange and COLORS.text or COLORS.dim
    end

    for p, r in pairs(rows) do
        if not seen[p] then
            r.row:Destroy()
            rows[p] = nil
        end
    end

    panelTitle.Text = string.format("PLAYERS  %d   in payload range  %d", #list, hit)
end

