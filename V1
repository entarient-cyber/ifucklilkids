local function toggleLangDropdown()
	langDropdownOpen = not langDropdownOpen
	if langDropdownOpen then
		playClick(1)
		local gAbs = gui.AbsolutePosition
		local pAbs = enPill.AbsolutePosition
		local pSize = enPill.AbsoluteSize
		
		langDropdown.Position = UDim2.fromOffset(pAbs.X - gAbs.X, pAbs.Y - gAbs.Y + pSize.Y + 8)
		langDropdown.Size = UDim2.fromOffset(170, 0)
		langDropdown.Visible = true
		
		tween(langDropdown, { Size = UDim2.fromOffset(170, 220) }, 0.2, Enum.EasingStyle.Quint)
	else
		local outTween = tween(langDropdown, { Size = UDim2.fromOffset(170, 0) }, 0.15, Enum.EasingStyle.Quint)
		outTween.Completed:Connect(function()
			if not langDropdownOpen then
				langDropdown.Visible = false
			end
		end)
	end
end

