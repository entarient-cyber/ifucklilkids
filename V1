local function filterSearch(query)
	clearDropdown()
	firstMatchTab = nil
	if query == "" then
		searchDropdown.Visible = false
		return
	end
	local q = string.lower(query)
	local matches = {}
	for _, item in ipairs(SEARCH_INDEX) do
		if string.find(string.lower(item.name), q, 1, true) then
			table.insert(matches, item)
		end
	end
	syncDropdown()
	searchDropdown.Visible = true
	if #matches == 0 then
		setDropdownHeight(36)
		new("TextLabel", {
			Size = UDim2.new(1,-16,0,36),
			Position = UDim2.new(0,8,0,0),
			BackgroundTransparency = 1,
			Text = "No results",
			TextColor3 = THEME.TextMute,
			Font = Enum.Font.Gotham,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 101, Parent = searchDropdown,
		})
		return
	end
	firstMatchTab = matches[1].tab
	local rowH = 36
	local showCount = math.min(#matches, 5)
	setDropdownHeight(showCount * rowH + 8)
	for i = 1, showCount do
		local m = matches[i]
		local row = new("TextButton", {
			Position = UDim2.new(0,4,0,4 + (i-1)*rowH),
			Size = UDim2.new(1,-8,0,rowH-4),
			BackgroundColor3 = THEME.SurfaceHi,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 101, Parent = searchDropdown,
		})
		corner(row, 6)
		local dot = new("Frame", {
			AnchorPoint = Vector2.new(0,0.5),
			Position = UDim2.new(0,10,0.5,0),
			Size = UDim2.new(0,6,0,6),
			BackgroundColor3 = THEME.MagmaMid,
			BorderSizePixel = 0, ZIndex = 102, Parent = row,
		})
		corner(dot, 999)
		new("TextLabel", {
			Position = UDim2.new(0,24,0,0),
			Size = UDim2.new(1,-80,1,0),
			BackgroundTransparency = 1,
			Text = m.name,
			TextColor3 = THEME.Text,
			Font = Enum.Font.GothamMedium,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 102, Parent = row,
		})
		new("TextLabel", {
			AnchorPoint = Vector2.new(1,0.5),
			Position = UDim2.new(1,-8,0.5,0),
			Size = UDim2.new(0,50,1,0),
			BackgroundTransparency = 1,
			Text = m.hint,
			TextColor3 = THEME.TextMute,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 102, Parent = row,
		})
