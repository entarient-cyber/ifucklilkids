local cornerRegistry = {}
local connections = {}
local function connect(sig, fn)
	local c = sig:Connect(fn); table.insert(connections, c); return c
end

local function new(class, props)
	local inst = Instance.new(class); local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	
	-- Black Text Outlines
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		if inst.TextStrokeTransparency == 1 then
			inst.TextStrokeTransparency = 0.4
			inst.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		end
	end
	
	if parent then inst.Parent = parent end
	return inst
end

local function corner(inst, r)
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = inst
	table.insert(cornerRegistry, { corner=c, radius=r })
	return c
end

local function tween(inst, props, dur, style, dir)
	local t = TweenService:Create(inst, TweenInfo.new(dur or 0.22, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	t:Play(); return t
end

